# Copy to .env and fill in. Never commit .env.
APIFY_TOKEN=
ANTHROPIC_API_KEY=
# 1 = every /api request needs Authorization: Bearer <key> from config/tenants.json
REQUIRE_AUTH=0
# Model alias passed to `claude -p --model`
RETURNS_MODEL=sonnet
# Optional overrides
# PORT=3141
# RATE_LIMIT_PER_MIN=60
# AUDIT_RETENTION_DAYS=90
